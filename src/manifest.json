{
  "manifest_version": 3,
  "name": "Downloader for Fansly",
  "version": "4.0.7",
  "description": "Download Fansly videos, images, text posts, and creator media batches directly to your computer.",
  "permissions": [
    "downloads",
    "activeTab",
    "storage",
    "tabs",
    "scripting",
    "offscreen",
    "cookies",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://auth.serp.co/*",
    "https://fansly.com/*",
    "https://*.fansly.com/*",
    "https://apiv3.fansly.com/*",
    "https://mediav2.fansly.com/*",
    "https://filesv2.fansly.com/*",
    "https://assets.fansly.com/*",
    "https://static2.fansly.com/*",
    "https://cdn2.fansly.com/*"
  ],
  "background": {
    "service_worker": "serp-bundles/background-service-worker.graph.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "serp-bundles/content-1.graph.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://fansly.com/*",
        "https://*.fansly.com/*"
      ],
      "js": [
        "serp-bundles/content-2.bundle.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Downloader for Fansly",
    "default_popup": "action-popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "offscreen.html",
        "offscreen.js",
        "indexed-db.js",
        "modules/*",
        "bulk-saver.html",
        "bulk-saver.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; child-src 'self';"
  }
}
